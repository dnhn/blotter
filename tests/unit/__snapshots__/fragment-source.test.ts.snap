   uPoint = texture2D(_userUniformsTexture, vec2(((2.0 + ((textIndex - ((1.0 / 2.0) / 2.0)) * 2.0)) / 4.0) + 0.03125000000000000000, 0.5)).xy;

   uResolution = _textBounds.zw;

{
  "name": "blotter-ts",
  "version": "1.0.0",
  "description": "A JavaScript API for drawing unconventional text effects on the web.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnhn/blotter.git"
  },
  "homepage": "https://github.com/dnhn/blotter#readme",
  "bugs": {
    "url": "https://github.com/dnhn/blotter/issues"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./materials": {
      "import": {
        "types": "./dist/materials.d.ts",
        "default": "./dist/materials.js"
      },
      "require": {
        "types": "./dist/materials.d.cts",
        "default": "./dist/materials.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "webgl",
    "glsl",
    "glsl-shaders",
    "typography",
    "text",
    "animation",
    "creative-coding"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "dev": "vite",
    "release": "pnpm build && changeset publish"
  },
  "peerDependencies": {
    "three": ">=0.152.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@changesets/cli": "^3.0.1",
    "@types/three": "^0.185.4",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "playwright": "^1.62.1",
    "three": "^0.185.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
